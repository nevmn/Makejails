OPTION start
OPTION overwrite=force
OPTION mount_devfs
OPTION tzdata
OPTION alias
OPTION ip4_inherit
OPTION ip6_inherit

INCLUDE ../poudriere.makejail/Makejail
INCLUDE ../workdir.makejail/Makejail
INCLUDE ../hostuser.makejail/Makejail

PKG neovim \
    git-tiny \
    nerd-fonts \
    lazygit \
    tree-sitter-cli \
    curl \
    fzf \
    ripgrep \
    fd-find \
    unzip \
    wget \
    bash \
    go \
    llvm19 \
    rust \
    devel/lua-luarocks \
    devel/php-composer \
    npm-node24 \
    python

CMD cargo install --root /opt/cargo --locked tree-sitter-cli
ENV PATH="/opt/cargo/bin:${PATH}"

CMD mkdir -p /home/hostuser/.config/nvim
CMD git clone https://github.com/LazyVim/starter /home/hostuser/.config/nvim
CMD rm -rf /home/hostuser/.config/nvim/.git
COPY .config/nvim /home/hostuser/.config

STAGE cmd
CMD --jexec --juser hostuser --workdir /workdir nvim
