OPTION start
OPTION overwrite=force
OPTION mount_devfs
OPTION tzdata
OPTION alias
OPTION ip4_inherit
OPTION ip6_inherit

INCLUDE ../poudriere.makejail/Makejail
INCLUDE ../workdir.makejail/Makejail
INCLUDE ../hostuser.makejail/Makejail

PKG node24 npm-node24

CMD --jexec --juser hostuser mkdir /home/hostuser/.npm
MOUNT --nopersist /var/cache/npm /home/hostuser/.npm nullfs rw

STAGE cmd
CMD --jexec --juser hostuser --workdir /workdir /bin/sh
